# Node / frontend build
Src/node_modules/
Src/dist/

# Arduino / PlatformIO
Arduino/.pio/
Arduino/.vscode/

# Python
__pycache__/
*.pyc
*.pyo
.python-version
.pytest_cache/
.env*
!.env.example

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Editor
.vscode/
.cursorignore

# Claude Code runtime
.claude/scheduled_tasks.lock
.claude/worktrees/

# Repomix packs (regenerate with .claude/repomix/regenerate.sh)
.claude/repomix/pack_*.md
repomix-output.*

# Logs
*.log

# Misc
tmp.py
tmp.md
od
out.txt

# Data / media – keep large & generated files out of the repo
Calibration/tmp/
*.mp4
*.avi
*.mov
*.mkv
*.bag
*.mcap

# Generated diagnostic plots (e.g. Analyze/slog_experiments.py output)
Analyze/Plots/

# Current-investigation outputs (figures/CSVs) + pooled tack dataset.
# Regenerate via Analyze/investigate_current.py, build_tack_dataset.py,
# leeway_report.py, stw_scale_*.py.
Analyze/CurrentOut/
Analyze/TackData/

# Playwright MCP scratch dir (per-tool-call snapshots / console logs).
.playwright-mcp/

# Stale 210 MB legacy starts dump — exceeded GitHub's 100 MB file limit.
Analyze/starts_legacy.json

# Per-problem feature snapshots produced by the start-detection pipeline.
# Regenerate locally via race_logs.read_log_file; not tracked.
Analyze/start_problem_*_features.parquet

# Per-recording transcripts/summaries/keypoints. Regenerate via
# Scripts/transcribe_audio.py + Scripts/summarize_transcript.py.
Analyze/Transcripts/

# Runtime artifacts from Scripts/migrate_virb.py (per-run JSON status files).
migrations/

# Repo data — kept in s3://regattaview-repo-data/tree/ (private, versioned),
# synced with Scripts/repo_data.py. Keep in lockstep with repo_data.manifest.
/Analyze/Notes/*/*
